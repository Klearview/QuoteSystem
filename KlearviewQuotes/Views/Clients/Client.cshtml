@model KlearviewQuotes.Models.Clients.Account
@{
    ViewData["Title"] = "Account";
}
<h3>@Html.DisplayFor(model => model.Name) - (#@Html.DisplayFor(model => model.Number))</h3>
<hr />

<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Number)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Number)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Name)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Name)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Active)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Active)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.TaxExempt)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.TaxExempt)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.AccountType)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.AccountType)
    </dd>
</dl>
<hr />

<h4>Service Locations</h4>
<div class="table-responsive table-wrapper">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Address</th>
                <th>Zone</th>
                <th>Name</th>
                <th>Active</th>
                <th>Service Memo</th>
                <th>Options</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ServiceLocations != null && Model.ServiceLocations.Count > 0)
            {
                @foreach (var item in Model.ServiceLocations)
                {
                    <tr>
                        <td style="white-space: pre-line">@Html.DisplayFor(modelItem => item.Address)</td>
                        <td>
                            @if (item.Zone != null) {
                                <span class="zone" style="background-color: @item.Zone.Color;">
                                    @Html.DisplayFor(modelItem => item.Zone.Name)
                                </span>
                            }                 
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Active)</td>
                        <td>@Html.DisplayFor(modelItem => item.ServiceMemo)</td>
                        <td>
                            <div class="d-flex">
                                <a asp-action="ServiceLocation" asp-route-id="@item.ServiceLocationId" class="btn btn-sm btn-primary">Details</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            @if (Model == null)
            {
                <tr>
                    <td colspan="6"><div class="text-center">No Service Locations</div></td>
                </tr>
            }
        </tbody>
    </table>
</div>
<hr />

<h4>Agreements</h4>
<div class="table-responsive table-wrapper">
    <table class="table table-striped">
        <colgroup>
            <col style="min-width: 150px" />
            <col style="min-width: 200px" />
            <col style="width: 120px" />
            <col style="width: 120px" />
            <col style="width: 140px" />
            <col style="width: 200px" />
            <col style="min-width: 100px" />
        </colgroup>
        <thead>
            <tr>
                <th>Name</th>
                <th>Service Location</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Completed On</th>
                <th>Canceled</th>
                <th>Options</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Agreements != null && Model.Agreements.Count > 0)
            {
                @foreach (var item in Model.Agreements)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>
                            <a style="white-space: pre-line" asp-action="ServiceLocation" asp-route-id="@item.ServiceLocationId">@Html.DisplayFor(modelItem => item.ServiceLocation.Address)</a>
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.StartDate)</td>
                        <td>@Html.DisplayFor(modelItem => item.EndDate)</td>
                        <td>@Html.DisplayFor(modelItem => item.CompletedOn)</td>
                        <td>
                            <div>@Html.DisplayFor(modelItem => item.CancelDate)</div>
                            <div>@Html.DisplayFor(modelItem => item.CancelReason)</div>
                            <div>@Html.DisplayFor(modelItem => item.CancelReasonOther)</div>
                        </td>
                        <td>
                            <div class="d-flex">
                                <a asp-action="Client" asp-route-id="@item.AccountId" class="btn btn-sm btn-primary">Details</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            @if (Model == null)
            {
                <tr>
                    <td colspan="6"><div class="text-center">No Agreements</div></td>
                </tr>
            }
        </tbody>
    </table>
</div>
