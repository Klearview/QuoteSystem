@using X.PagedList.Mvc.Core
@using X.PagedList.Web.Common
@model KlearviewQuotes.Models.ViewModels.ClientViewModel 
@{
    ViewData["Title"] = "Client";
}
<h3>@Html.DisplayFor(model => model.Account.Name) - (#@Html.DisplayFor(model => model.Account.Number))</h3>
<hr />

<table class="table info-table">
    <tbody>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Account.Number)</th>
            <td>@Html.DisplayFor(model => model.Account.Number)</td>
        </tr>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Account.Name)</th>
            <td>@Html.DisplayFor(model => model.Account.Name)</td>
        </tr>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Account.Active)</th>
            <td>@Html.DisplayFor(model => model.Account.Active)</td>
        </tr>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Account.AccountType)</th>
            <td>@Html.DisplayFor(model => model.Account.AccountType)</td>
        </tr>
        <tr>
            <th>Default Service Location</th>
            <td>@await Html.PartialAsync("../Location/_ServiceLocationLinkPartial", Model.Account.DefaultServiceLocation)</td>
        </tr>
        <tr>
            <th>Default Billing Location</th>
            <td>@await Html.PartialAsync("../Location/_BillingLocationLinkPartial", Model.Account.DefualtBillingLocation)</td>
        </tr>
    </tbody>
</table>


<h4>Service Locations</h4>
<div class="table-responsive table-wrapper">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Address</th>
                <th>Zone</th>
                <th>Name</th>
                <th>Active</th>
                <th>Service Memo</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Account.ServiceLocations != null && Model.Account.ServiceLocations.Count > 0)
            {
                @foreach (var item in Model.Account.ServiceLocations)
                {
                    <tr>
                        <td style="white-space: pre-line">@Html.DisplayFor(modelItem => item.Address)</td>
                        <td>
                            @if (item.Zone != null) {
                                <span class="zone" style="background-color: @item.Zone.Color;">
                                    @Html.DisplayFor(modelItem => item.Zone.Name)
                                </span>
                            }                 
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Active)</td>
                        <td>@Html.DisplayFor(modelItem => item.ServiceMemo)</td>
                    </tr>
                }
            }
            @if (Model == null)
            {
                <tr>
                    <td colspan="6"><div class="text-center">No Service Locations</div></td>
                </tr>
            }
        </tbody>
    </table>
</div>
<hr />

<h4 id="agreements">Agreements</h4>
<div class="table-responsive table-wrapper">
    @await Html.PartialAsync("../Agreements/_AgreementsListPartial", Model.PagedAgreements)

    @if (Model.PagedAgreements.PageCount > 1) {

        <div>
            Page @(Model.PagedAgreements.PageCount < Model.PagedAgreements.PageNumber ? 0 : Model.PagedAgreements.PageNumber) of @Model.PagedAgreements.PageCount

            @Html.PagedListPager(Model.PagedAgreements, agreementPage => Url.Action("Details",
                     new
                     {
                         id = Model.Account.AccountId,
                         agreementPage = agreementPage,
                         workOrderPage = ViewBag.CurrentWorkOrderPage,
                     }) + "#agreements",
                     new PagedListRenderOptions()
                        {
                            ActiveLiElementClass = "active",
                            PageClasses = new[] { "page-link" },
                            LiElementClasses = new[] { "page-item" },
                            UlElementClasses = new[] { "pagination", "justify-content-center", "mt-3" },
                            LinkToNextPageFormat = "Next",
                            LinkToPreviousPageFormat = "Previous",
                            MaximumPageNumbersToDisplay = 5,
                            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                            DisplayLinkToNextPage = PagedListDisplayMode.Always
                        })
        </div>
    }
</div>
<hr />

<h4 id="workOrders">Work Orders</h4>
<div class="table-responsive table-wrapper">
    @await Html.PartialAsync("../WorkOrders/_WorkOrderListPartial", Model.PagedWorkOrders)
    
    @if (Model.PagedWorkOrders.PageCount > 1)
    {

        <div>
            Page @(Model.PagedWorkOrders.PageCount < Model.PagedWorkOrders.PageNumber ? 0 : Model.PagedWorkOrders.PageNumber) of @Model.PagedWorkOrders.PageCount

            @Html.PagedListPager(Model.PagedWorkOrders, workOrderPage => Url.Action("Details",
                     new
                     {
                         id = Model.Account.AccountId,
                         agreementPage = ViewBag.CurrentAgreementPage,
                         workOrderPage = workOrderPage,
                     }) + "#workOrders",
                     new PagedListRenderOptions()
                        {
                            ActiveLiElementClass = "active",
                            PageClasses = new[] { "page-link" },
                            LiElementClasses = new[] { "page-item" },
                            UlElementClasses = new[] { "pagination", "justify-content-center", "mt-3" },
                            LinkToNextPageFormat = "Next",
                            LinkToPreviousPageFormat = "Previous",
                            MaximumPageNumbersToDisplay = 5,
                            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                            DisplayLinkToNextPage = PagedListDisplayMode.Always
                        })
        </div>
    }   
</div>