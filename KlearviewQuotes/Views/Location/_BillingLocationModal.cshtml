@model KlearviewQuotes.Models.Clients.BillingLocation

<div class="modal fade" id="locationModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Billing Location</h5>
                <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div style="padding: 1rem;" class="d-flex gap-2">
                <div>
                    <h5>Contact</h5>
                    @await Html.PartialAsync("_ContactPartial", Model.DefaultContact)

                    <h6>Contact Address</h6>
                    @await Html.PartialAsync("_LocationPartial", Model.DefaultContact)
                </div>
                <div style="background-color: grey; width: 1px;"></div>
                <div>
                    <h5>Location</h5>
                    <table class="table">
                        <colgroup>
                            <col style="min-width: 200px" />
                            <col style="min-width: 300px" />
                        </colgroup>
                        <tbody>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.Name)</th>
                                <td>@Html.DisplayFor(model => model.Name)</td>
                            </tr>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.BillingMemo)</th>
                                <td>@Html.DisplayFor(model => model.BillingMemo)</td>
                            </tr>
                        </tbody>
                    </table>

                    <h6>Location Addreess</h6>
                    <partial name="_LocationPartial" />
                </div>
            </div>
        </div>
    </div>
</div>