@model KlearviewQuotes.Models.Clients.WorkOrder
@{
    ViewData["Title"] = "Work Order";
}

<a asp-action="Details" asp-controller="Clients" asp-route-id="@Model.AccountId" class="btn btn-sm btn-link">&#60; Account</a>

<h3>Work Order #@Html.DisplayFor(model => model.Number)</h3>
<hr />

<table class="table info-table">
    <tr>
        <th>@Html.DisplayNameFor(model => model.Number)</th>
        <td>@Html.DisplayFor(model => model.Number)</td>
    </tr>
    <tr>
        <th>Service Location</th>
        <td>
            @await Html.PartialAsync("../Location/_ServiceLocationLinkPartial", Model.ServiceLocation)
            <a href="@Model.ServiceLocation.GoogleMapsURL" target="_blank" class="text-decoration-none" style="margin-left: 2rem;">
                Open in Maps
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-geo-alt-fill" viewBox="0 0 16 16">
                    <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6"></path>
                </svg>
            </a>
        </td>
    </tr>
    <tr>
        <th>@Html.DisplayNameFor(model => model.ServiceLocationServiceMemo)</th>
        <td>@Html.DisplayFor(model => model.ServiceLocationServiceMemo)</td>
    </tr>
    <tr>
        <th>Billing Location</th>
        <td>
            @await Html.PartialAsync("../Location/_BillingLocationLinkPartial", Model.BillingLocation)
            <a href="@Model.BillingLocation.GoogleMapsURL" target="_blank" class="text-decoration-none" style="margin-left: 2rem;">
                Open in Maps
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-geo-alt-fill" viewBox="0 0 16 16">
                    <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6"></path>
                </svg>
            </a>
        </td>
    </tr>
    <tr>
        <th>@Html.DisplayNameFor(model => model.BillingLocationBillingMemo)</th>
        <td>@Html.DisplayFor(model => model.BillingLocationBillingMemo)</td>
    </tr>
    <tr>
        <th>@Html.DisplayNameFor(model => model.ScheduledDate)</th>
        <td>@Html.DisplayFor(model => model.ScheduledDate)</td>
    </tr>
    @if (!string.IsNullOrEmpty(Model.CancelledDate))
    {
        <tr>
            <th>Canceled</th>
            <td>
                <div>@Html.DisplayFor(model => model.CancelledDate)</div>
                <div>@Html.DisplayFor(model => model.CancelReason)</div>
                <div>@Html.DisplayFor(model => model.CancelReasonOther)</div>
            </td>
        </tr>
    }
    <tr>
        <th>@Html.DisplayNameFor(model => model.Resource)</th>
        <td>@Html.DisplayFor(model => model.Resource.Name)</td>
    </tr>
    @if (Model.CommittedResource != null) 
    {
        <tr>
            <th>@Html.DisplayNameFor(model => model.CommittedResource)</th>
            <td>@Html.DisplayFor(model => model.CommittedResource.Name)</td>
        </tr>
    }
    @if (Model.PerformedByResource != null)
    {
        <tr>
            <th>@Html.DisplayNameFor(model => model.PerformedByResource)</th>
            <td>@Html.DisplayFor(model => model.PerformedByResource.Name)</td>
        </tr>
    }
    @if (Model.Campaign != null)
    {
        <tr>
            <th>@Html.DisplayNameFor(model => model.Campaign)</th>
            <td>@Html.DisplayFor(model => model.Campaign.Name)</td>
        </tr>
    }
</table>
<hr />

<h4>Service Infromation</h4>
<table class="table table-striped">
    <colgroup>
        <col />
        <col style="width: 150px" />
        <col style="width: 150px" />
    </colgroup>
    <thead>
        <tr>
            <th>Services</th>
            <th>Rate</th>
            <th>Price</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.WorkOrderServices != null && Model.WorkOrderServices.Count > 0) 
        {
            @foreach (var item in Model.WorkOrderServices) 
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Description)</td>
                    <td>$@Html.DisplayFor(modelItem => item.Rate) / visit</td>
                    <td>$@Html.DisplayFor(modelItem => item.Rate)</td>
                </tr>
            }
        }
    </tbody>
    <tfoot>
        <tr>
            <td></td>
            <th>Subtotal</th>
            <th>$@Html.DisplayFor(model => model.SubTotal)</th>
        </tr>
    </tfoot>
</table>
<hr />

@if (Model.UserDefinedFieldValues.Count > 0)
{
    <h4>Custom Fields</h4>
    <table class="table info-table">
        @foreach (var item in Model.UserDefinedFieldValues)
        {
            <tr>
                <th>@Html.DisplayFor(modelItem => item.UserDefinedField.Label)</th>
                <td>@Html.DisplayFor(modelItem => item.Text)</td>
            </tr>
        }
    </table>

}
else
{
    <p>No Custom Fields for this Work Order</p>
}