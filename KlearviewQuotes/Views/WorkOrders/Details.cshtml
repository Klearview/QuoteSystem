@model KlearviewQuotes.Models.Clients.WorkOrder
@{
    ViewData["Title"] = "Work Order";
}

<div id="modal-container">
</div>

<h3>Work Order #@Html.DisplayFor(model => model.Number)</h3>
<hr />

<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Number)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Number)
    </dd>

    <dt class="col-sm-2">
        Service Location
    </dt>
    <dd class="col-sm-10">
        <button class="btn btn-link"
                data-toggle="ajax-modal"
                data-target="#locationModal"
                style="white-space: pre-line; text-align: left; padding: 0;"
                data-url="@Url.Action("Service", "Location")/@Model.ServiceLocationId"
        >@Html.DisplayFor(model => model.ServiceLocation.Address)
        </button>
    </dd>

    <dt class="col-sm-2">
        Billing Location
    </dt>
    <dd class="col-sm-10">
        <button class="btn btn-link"
                data-toggle="ajax-modal"
                data-target="#locationModal"
                style="white-space: pre-line; text-align: left; padding: 0;"
                data-url="@Url.Action("Billing", "Location")/@Model.BillingLocationId"
        >@Html.DisplayFor(model => model.BillingLocation.Address)
        </button>
    </dd>
</dl>
<hr />