@using X.PagedList
@using X.PagedList.Mvc.Core
@using X.PagedList.Web.Common
@model IPagedList<KlearviewQuotes.Models.Clients.WorkOrder>;
@{
    string controller = ViewContext.RouteData.Values["controller"].ToString();
    string actionLink = controller == "Clients" ? "Client" : "Index";
}

<table class="table table-striped">
    <thead>
        <tr>
            @if (controller == "Clients") {
                <th>Number</th>
            } else {
                <th>
                    @Html.ActionLink("Number", actionLink, null, null, null, "workOrders", new
                        {
                            woSort = ViewBag.WoNumberParm,
                            accountType = ViewBag.CurrentAccountType ?? ""
                        }, null)
                </th>
                <th>Customer Name</th>
            }
            <th>Service Location</th>
            <th>Billing Location</th>
            <th>Scheduled Date</th>
            @if (controller == "Clients")
            {
                <th>Sub Total</th>
            }
            else
            {
                <th>
                    @Html.ActionLink("Sub Total", actionLink, null, null, null, "workOrders", new
                        {
                            woSort = ViewBag.WoSubTotalParm,
                            accountType = ViewBag.CurrentAccountType ?? ""
                        }, null)
                </th>
            }
            <th>Status</th>
            @if (controller == "WorkOrders") {
                <th>Account Type</th>
            }
            <th>Options</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Number)</td>
                    @if (controller == "WorkOrders")
                    {
                        <td>@Html.DisplayFor(modelItem => item.Account.Name)</td>
                    }
                    <td>
                        @await Html.PartialAsync("../Location/_ServiceLocationLinkPartial", item.ServiceLocation)
                    </td>
                    <td>
                        @await Html.PartialAsync("../Location/_BillingLocationLinkPartial", item.BillingLocation)
                    </td>
                    <td>@Html.DisplayFor(modelItem => item.ScheduledDate)</td>
                    <td>$@Html.DisplayFor(modelItem => item.SubTotal)</td>
                    <td>@Html.DisplayFor(modelItem => item.Status)</td>
                    @if (controller == "WorkOrders")
                    {
                        <td>@Html.DisplayFor(modelItem => item.Account.AccountType)</td>
                    }
                    <td>
                        <div class="d-flex">
                            <a asp-action="Details" asp-controller="WorkOrders" asp-route-id="@item.WorkOrderId" class="btn btn-sm btn-primary">Details</a>
                        </div>
                    </td>
                </tr>
            }
        }
        @if (Model == null)
        {
            <tr>
                <td colspan="6"><div class="text-center">No Work Orders</div></td>
            </tr>
        }
    </tbody>
</table>
